# GitHub token used to query your GitHub Project (see auth/ghub.example.json)
GITHUB_TOKEN=your_github_token_here

# GitHub Project V2 node ID (see auth/ghub.example.json)
GITHUB_PROJECT_ID=PVT_xxxxxxxxxx

# Optional application settings
CAL_AUTO_CONFIG_DIR=/path/to/user/config
CAL_AUTO_TIMEZONE=Europe/Lisbon
CAL_AUTO_WORKING_DAY_START=09:00
CAL_AUTO_WORKING_DAY_END=17:00
CAL_AUTO_CALENDAR_ID=primary
CAL_AUTO_TASK_LIST_ID=@default
CAL_AUTO_ATTENDEES=you@example.com
CAL_AUTO_SCHEDULABLE_STATUSES=Backlog
